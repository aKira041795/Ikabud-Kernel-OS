includes:
    - phpstan-baseline.neon

parameters:
    level: 6
    paths:
        - kernel
        - src
        - modules
    excludePaths:
        - analyse
        - '**/*Test.php'
        - modules/*/builder-ui
        - modules/*/node_modules
        - vendor
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # Bootstrap global functions used before class-based resolution
        - '#Function [a-zA-Z_]+ not found#'
        # Dynamic module loading patterns
        - '#Variable \$[a-zA-Z_]+ might not be defined#'
        # --- Path-specific level overrides ---
        # kernel/ stays at level 6 (the global level)
        # modules/ relaxed to level 4 during initial rollout

    # Baseline — existing errors accepted during initial rollout so CI
    # gates on NEW errors only. Regenerate with:
    #   php vendor/bin/phpstan analyse --generate-baseline phpstan-baseline.neon
    # As the baseline shrinks toward zero it can be deleted.
