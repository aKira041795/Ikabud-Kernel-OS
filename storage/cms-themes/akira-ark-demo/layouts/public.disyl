<!doctype html>
<html lang="en" data-akira-theme="akira-ark-demo">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{page_title}</title>
  {if seo_description}<meta name="description" content="{seo_description}">{/if}
  {if canonical_url}<link rel="canonical" href="{canonical_url}">{/if}
  <style>
    :root{--color-primary:#7c3aed;--color-primary-dark:#5b21b6;--color-accent:#f59e0b;--color-surface:#fffbeb;--color-raised:#fff;--color-text:#172554;--color-muted:#64748b;--color-border:#cbd5e1;--font-family:Georgia,'Times New Roman',serif;--page:1.25rem;--radius:1rem}
    *{box-sizing:border-box}body{margin:0;background:var(--color-surface);color:var(--color-text);font-family:var(--font-family);line-height:1.65}a{color:var(--color-primary-dark)}.akira-ark-wrap{max-width:1120px;margin:auto;padding:0 var(--page)}.akira-ark-main{min-height:62vh}.akira-ark-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:1.25rem;padding:3rem 0}.akira-ark-card{background:var(--color-raised);border:1px solid var(--color-border);border-radius:var(--radius);padding:1.4rem;box-shadow:0 8px 30px #7c3aed12}.akira-ark-card img,.akira-ark-article img{width:100%;max-height:420px;object-fit:cover;border-radius:.75rem}.akira-ark-kicker{color:var(--color-primary);font:700 .75rem system-ui;text-transform:uppercase;letter-spacing:.12em}.akira-ark-article{max-width:720px;margin:auto;padding:4rem var(--page)}.akira-ark-article h1{font-size:clamp(2.4rem,7vw,4.8rem);line-height:1.05}.akira-ark-body{white-space:pre-wrap;font-size:1.15rem}.akira-ark-empty{padding:5rem 0;text-align:center;color:var(--color-muted)}
  </style>
</head>
<body>
  <a href="#main-content" style="position:absolute;left:-9999px">Skip to content</a>
  {header_region|raw}
  <main id="main-content" class="akira-ark-main">{page_region|raw}</main>
  {footer_region|raw}
</body>
</html>
