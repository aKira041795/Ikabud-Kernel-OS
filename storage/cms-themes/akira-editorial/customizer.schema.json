{
  "schema_version": "1.0.0",
  "sections": {
    "header": {
      "label": "Header",
      "controls": {
        "brand": {
          "type": "text",
          "label": "Brand",
          "default": "CMS Akira"
        }
      }
    },
    "footer": {
      "label": "Footer",
      "controls": {
        "message": {
          "type": "text",
          "label": "Message",
          "default": "Governed publishing on Ikabud"
        }
      }
    },
    "design_colors": {
      "label": "Design colours",
      "controls": {
        "color_primary": {
          "type": "color",
          "label": "Primary",
          "default": "#005c55"
        },
        "color_primary_dark": {
          "type": "color",
          "label": "Primary dark",
          "default": "#0f766e"
        },
        "color_primary_soft": {
          "type": "color",
          "label": "Primary soft",
          "default": "#9cf2e8"
        },
        "color_accent": {
          "type": "color",
          "label": "Accent",
          "default": "#fea619"
        },
        "color_accent_deep": {
          "type": "color",
          "label": "Accent deep",
          "default": "#855300"
        },
        "color_tertiary": {
          "type": "color",
          "label": "Tertiary",
          "default": "#7f4025"
        },
        "color_surface": {
          "type": "color",
          "label": "Surface",
          "default": "#faf8ff"
        },
        "color_surface_raised": {
          "type": "color",
          "label": "Raised surface",
          "default": "#ffffff"
        },
        "color_surface_low": {
          "type": "color",
          "label": "Low surface",
          "default": "#f3f2ff"
        },
        "color_surface_container": {
          "type": "color",
          "label": "Surface container",
          "default": "#ebedff"
        },
        "color_text": {
          "type": "color",
          "label": "Text",
          "default": "#071747"
        },
        "color_text_muted": {
          "type": "color",
          "label": "Muted text",
          "default": "#3e4947"
        },
        "color_outline": {
          "type": "color",
          "label": "Outline",
          "default": "#6e7977"
        },
        "color_border": {
          "type": "color",
          "label": "Border",
          "default": "#bdc9c6"
        },
        "color_error": {
          "type": "color",
          "label": "Error",
          "default": "#ba1a1a"
        }
      }
    },
    "design_typography": {
      "label": "Design typography",
      "controls": {
        "font_family": {
          "type": "text",
          "label": "Editorial font family",
          "default": "'Source Serif 4', Georgia, 'Times New Roman', serif"
        },
        "font_family_ui": {
          "type": "text",
          "label": "Interface font family",
          "default": "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
        }
      }
    },
    "design_layout": {
      "label": "Design layout",
      "controls": {
        "spacing_page": {
          "type": "text",
          "label": "Page spacing",
          "default": "1.25rem"
        },
        "radius_card": {
          "type": "text",
          "label": "Card radius",
          "default": "0.75rem"
        },
        "container_max": {
          "type": "text",
          "label": "Container maximum width",
          "default": "1120px"
        },
        "reading_width": {
          "type": "text",
          "label": "Reading width",
          "default": "720px"
        }
      }
    }
  }
}
