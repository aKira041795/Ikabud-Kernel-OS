<!doctype html>
<html lang="en" data-akira-theme="akira-editorial">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{page_title}</title>
  {if seo_description}<meta name="description" content="{seo_description}">{/if}
  {if canonical_url}<link rel="canonical" href="{canonical_url}">{/if}
  <style>
    :root{
      --color-primary:#005c55; --color-primary-dark:#0f766e; --color-primary-soft:#9cf2e8;
      --color-accent:#fea619; --color-accent-deep:#855300; --color-tertiary:#7f4025;
      --color-surface:#faf8ff; --color-surface-raised:#ffffff;
      --color-surface-low:#f3f2ff; --color-surface-container:#ebedff;
      --color-text:#071747; --color-text-muted:#3e4947;
      --color-outline:#6e7977; --color-border:#bdc9c6; --color-error:#ba1a1a;
      --font-family:'Source Serif 4',Georgia,'Times New Roman',serif;
      --font-family-ui:Inter,system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
      --font-serif:var(--font-family); --font-ui:var(--font-family-ui);
      --container-max:1120px; --reading-width:720px;
      --container:var(--container-max); --reading:var(--reading-width);
      --spacing-page:1.25rem; --gutter:var(--spacing-page); --gutter-md:1.5rem; --gutter-lg:2rem;
      --radius-card:0.75rem; --radius-sm:0.25rem; --radius:0.5rem; --radius-lg:var(--radius-card);
      --shadow-sm:0 1px 2px rgba(7,23,71,.06),0 1px 3px rgba(7,23,71,.04);
      --shadow-md:0 4px 12px rgba(7,23,71,.08),0 2px 4px rgba(7,23,71,.04);
    }
    *,*::before,*::after{box-sizing:border-box}
    html{-webkit-text-size-adjust:100%}
    body{margin:0;background:var(--color-surface);color:var(--color-text);font-family:var(--font-ui);font-size:15px;line-height:22px;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}
    img{max-width:100%;display:block}
    a{color:inherit;text-decoration:none}
    h1,h2,h3,h4{font-family:var(--font-serif);margin:0;font-weight:600}
    p{margin:0}
    .container{width:100%;max-width:var(--container);margin-inline:auto;padding-inline:var(--gutter)}
    @media(min-width:768px){.container{padding-inline:var(--gutter-md)}}
    @media(min-width:1024px){.container{padding-inline:var(--gutter-lg)}}
    .skip-link{position:absolute;left:-9999px;top:0}
    .skip-link:focus{left:1rem;top:1rem;z-index:100;background:var(--color-primary);color:#fff;padding:.5rem 1rem;border-radius:var(--radius)}
    .t-kicker{font-family:var(--font-ui);font-size:12px;line-height:16px;letter-spacing:.08em;font-weight:700;text-transform:uppercase}
    .t-meta{font-size:13px;line-height:18px;font-weight:500;color:var(--color-text-muted)}
    .t-display{font-size:clamp(36px,6vw,56px);line-height:1.14;letter-spacing:-.02em;font-weight:700}
    .t-headline-lg{font-size:clamp(28px,4vw,40px);line-height:1.2;letter-spacing:-.015em}
    .t-headline-md{font-size:28px;line-height:36px;letter-spacing:-.01em}
    .t-headline-sm{font-size:22px;line-height:30px}
    .t-lead{font-family:var(--font-serif);font-size:22px;line-height:36px;color:var(--color-text-muted)}
    .btn{display:inline-flex;align-items:center;gap:.5rem;background:var(--color-primary);color:#fff;font-family:var(--font-ui);font-size:14px;line-height:20px;font-weight:600;letter-spacing:.01em;padding:.75rem 1.5rem;border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);transition:background .2s,box-shadow .2s}
    .btn:hover{background:var(--color-primary-dark);box-shadow:var(--shadow-md)}
    .site-header{position:sticky;top:0;z-index:40;background:rgba(250,248,255,.9);backdrop-filter:blur(12px);border-bottom:1px solid var(--color-border)}
    .site-header__inner{display:flex;align-items:center;justify-content:space-between;gap:1.5rem;height:5rem}
    .site-brand{display:flex;align-items:center;gap:.75rem}
    .site-brand__mark{display:grid;place-items:center;width:2rem;height:2rem;border-radius:var(--radius);background:var(--color-primary);color:#fff;font-family:var(--font-serif);font-weight:700}
    .site-brand__name{font-family:var(--font-serif);font-size:22px;line-height:30px;font-weight:600;letter-spacing:-.01em}
    .site-nav{display:flex;align-items:center;gap:1.5rem;margin-left:1rem}
    .site-nav__link{font-size:15px;line-height:22px;color:var(--color-text-muted);padding-block:.25rem;transition:color .2s}
    .site-nav__link:hover{color:var(--color-text)}
    .site-nav__link--active{color:var(--color-primary);font-weight:600;text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:8px}
    @media(max-width:639px){.site-nav{display:none}}
    .site-main{min-height:100vh;padding-top:2rem}
    .hero{max-width:840px;margin:0 auto 5rem;text-align:center;padding-top:3rem}
    .hero__kicker{color:var(--color-accent-deep);margin-bottom:1.5rem}
    .hero__title{margin-bottom:1.5rem}
    .hero__lead{max-width:var(--reading);margin:0 auto 2rem}
    .hero__byline{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.75rem;margin-bottom:2.5rem}
    .hero__avatar{display:grid;place-items:center;width:1.75rem;height:1.75rem;border-radius:9999px;background:var(--color-primary-dark);color:#fff;font-size:.7rem;font-weight:700}
    .hero__author{font-weight:600;color:var(--color-text)}
    .hero__sep{color:var(--color-outline)}
    .hero__ornament{display:flex;align-items:center;justify-content:center;gap:.5rem;margin-top:4rem}
    .hero__ornament span{width:1.5rem;height:1.5rem;max-width:0.375rem;max-height:0.375rem;border-radius:9999px;background:var(--color-accent)}
    .hero__ornament i{display:block;width:2rem;height:1px;background:var(--color-border)}
    .section-head{display:flex;flex-direction:column;gap:1rem;padding-bottom:1.5rem;margin-bottom:2.5rem;border-bottom:1px solid var(--color-border)}
    .section-head__kicker{color:var(--color-primary)}
    .section-head__count{color:var(--color-text-muted);font-size:13px;line-height:18px;font-weight:500}
    @media(min-width:768px){.section-head{flex-direction:row;align-items:flex-end;justify-content:space-between}}
    .card-grid{display:grid;grid-template-columns:1fr;gap:1.5rem}
    @media(min-width:768px){.card-grid{grid-template-columns:repeat(2,1fr)}}
    @media(min-width:1024px){.card-grid{grid-template-columns:repeat(3,1fr)}}
    .card{display:flex;flex-direction:column;background:var(--color-surface-raised);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);overflow:hidden;transition:box-shadow .3s}
    .card:hover{box-shadow:var(--shadow-md)}
    .card__media{position:relative;aspect-ratio:16/10;overflow:hidden;background:var(--color-surface-container)}
    .card__media img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
    .card:hover .card__media img{transform:scale(1.02)}
    .card__badge{position:absolute;top:.75rem;left:.75rem;background:rgba(255,255,255,.92);color:var(--color-primary);padding:.25rem .625rem;border-radius:var(--radius-sm);font-size:12px;line-height:16px;letter-spacing:.08em;font-weight:700;text-transform:uppercase}
    .card__body{display:flex;flex-direction:column;flex:1;padding:1.5rem}
    .card__date{margin-bottom:.5rem}
    .card__title{font-family:var(--font-serif);font-size:22px;line-height:30px;font-weight:600;margin-bottom:.75rem;transition:color .2s}
    .card:hover .card__title{color:var(--color-primary)}
    .card__excerpt{font-size:15px;line-height:22px;color:var(--color-text-muted);margin-bottom:1.5rem}
    .card__foot{margin-top:auto;padding-top:1rem;display:flex;align-items:center;justify-content:space-between;gap:1rem}
    .card__author{font-size:13px;line-height:18px;font-weight:500;color:var(--color-text)}
    .card__more{font-size:14px;line-height:20px;font-weight:600;color:var(--color-primary);transition:transform .2s}
    .card:hover .card__more{transform:translateX(2px)}
    .state-empty{max-width:36rem;margin:0 auto;padding:4rem 1.5rem;text-align:center;background:var(--color-surface-raised);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm)}
    .state-empty__icon{display:grid;place-items:center;width:4rem;height:4rem;margin:0 auto 1rem;border-radius:9999px;background:var(--color-surface-container);color:var(--color-text-muted);font-size:1.5rem}
    .state-empty h3{margin-bottom:.5rem}
    .state-empty p{color:var(--color-text-muted);max-width:24rem;margin:0 auto 1.5rem}
    .cta{max-width:800px;margin:5rem auto 0;padding:3rem;background:var(--color-surface-raised);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);text-align:center}
    .cta__kicker{display:inline-block;color:var(--color-primary);margin-bottom:1rem}
    .cta__title{margin-bottom:.75rem}
    .cta__body{max-width:560px;margin:0 auto 2rem;color:var(--color-text-muted);font-size:15px;line-height:22px}
    .cta__actions{display:flex;flex-wrap:wrap;gap:.75rem;justify-content:center}
    .content-block,.editorial-quote{width:calc(100% - (2 * var(--gutter)));max-width:var(--container);margin:3rem auto}
    .content-block__title{margin-bottom:1.5rem}
    .content-card-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:1rem}
    .content-card{display:flex;min-width:0;flex-direction:column;padding:1.5rem;background:var(--color-surface-raised);border:1px solid var(--color-border);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm)}
    .content-card__title{margin-bottom:.75rem}
    .content-card__text{color:var(--color-text-muted);margin-bottom:1.25rem}
    .content-card__link{align-self:flex-start;margin-top:auto;color:var(--color-primary);font-weight:600;text-decoration:underline;text-underline-offset:3px}
    .editorial-quote{max-width:var(--reading);padding:2rem;background:var(--color-surface-raised);border-left:4px solid var(--color-primary);border-radius:var(--radius);box-shadow:var(--shadow-sm)}
    .editorial-quote blockquote{margin:0;font-family:var(--font-serif);font-size:clamp(22px,4vw,30px);line-height:1.4;font-style:italic}
    .editorial-quote figcaption{margin-top:1rem;color:var(--color-text-muted);font-size:14px;font-weight:600}
    .richtext{max-width:var(--reading)}
    .richtext__title{margin-bottom:1.25rem}
    .richtext__body{font-family:var(--font-serif);font-size:19px;line-height:32px;white-space:pre-wrap;overflow-wrap:anywhere}
    @media(min-width:768px){.content-block,.editorial-quote{width:calc(100% - (2 * var(--gutter-md)));margin-block:4rem}.content-card-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem}.editorial-quote{padding:2.5rem}}
    @media(min-width:1024px){.content-block,.editorial-quote{width:calc(100% - (2 * var(--gutter-lg)))}.content-card-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
    .site-footer{border-top:1px solid var(--color-border);padding-block:2rem;margin-top:6rem}
    .site-footer__inner{display:flex;flex-direction:column;align-items:center;justify-content:space-between;gap:1rem}
    .site-footer__note{font-size:13px;line-height:18px;color:var(--color-text-muted)}
    .site-footer__nav{display:flex;flex-wrap:wrap;gap:1.5rem;font-size:13px;line-height:18px;color:var(--color-text-muted)}
    .site-footer__nav a:hover{color:var(--color-text)}
    @media(min-width:768px){.site-footer__inner{flex-direction:row}}
    .post-detail{max-width:var(--reading);margin-inline:auto;padding-block:3rem}
    .post-detail__back{display:inline-block;font-size:14px;line-height:20px;font-weight:600;color:var(--color-primary);margin-bottom:2rem}
    .post-detail__back:hover{text-decoration:underline;text-underline-offset:3px}
    .post-detail__header{margin-bottom:2rem}
    .post-detail__kicker{color:var(--color-accent-deep);margin-bottom:.75rem}
    .post-detail__title{margin-bottom:1rem}
    .post-detail__subtitle{margin-top:1rem}
    .post-detail__figure{margin:2rem 0}
    .post-detail__figure img{width:100%;border-radius:var(--radius-lg)}
    .post-detail__tags{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:3rem;padding-top:1.5rem;border-top:1px solid var(--color-border)}
    .tag{display:inline-block;padding:.25rem .75rem;border:1px solid var(--color-border);border-radius:9999px;background:var(--color-surface-raised);font-size:13px;line-height:18px;color:var(--color-text-muted)}
    .post-body{font-family:var(--font-serif);font-size:19px;line-height:32px}
    .post-body h2{font-size:28px;line-height:36px;margin-block:2rem 1rem}
    .post-body h3{font-size:22px;line-height:30px;margin-block:1.75rem .75rem}
    .post-body p{margin-block:0 1.25rem}
    .post-body a{color:var(--color-primary);text-decoration:underline;text-underline-offset:3px}
    .post-body blockquote{margin:2rem 0;padding-left:1.25rem;border-left:2px solid var(--color-accent);font-size:26px;line-height:38px;font-style:italic}
    .post-body ul,.post-body ol{margin-block:0 1.25rem;padding-left:1.25rem}
    .post-body li{margin-bottom:.5rem}
    .post-body img{max-width:100%;height:auto;border-radius:var(--radius-lg);margin-block:2rem}
    .post-body figure{margin-block:2rem}
    .post-body figcaption{margin-top:.5rem;font-family:var(--font-ui);font-size:13px;line-height:18px;color:var(--color-text-muted)}
    .post-body pre{overflow-x:auto;padding:1rem;border-radius:var(--radius);background:var(--color-surface-container)}
    .post-body code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.9em}
  </style>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  {header_region|raw}
  <main id="main-content" class="site-main">{page_region|raw}</main>
  {footer_region|raw}
</body>
</html>
