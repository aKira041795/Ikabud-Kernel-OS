<p class="mt-2 text-slate-600">Create and review tenant-scoped menus used by Akira navigation locations.</p>

{if error}
    <div class="mt-6 rounded-xl border border-red-200 bg-red-50 p-4 text-red-700" role="alert">{error}</div>
{/if}
{if saved}
    <div class="mt-6 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-emerald-700" role="status">Menu created.</div>
{/if}

<section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-xl font-bold text-slate-950">Create menu</h2>
    <form class="mt-5 grid gap-4 md:grid-cols-3" method="post" action="/cms-akira-navigation/menu/create">
        {csrf_field | raw}
        <input type="hidden" name="idempotency_key" value="{idempotency_key}">
        <label class="grid gap-1 text-sm font-semibold">Title
            <input class="rounded-lg border border-slate-300 px-3 py-2 font-normal" name="title" required maxlength="255">
        </label>
        <label class="grid gap-1 text-sm font-semibold">Slug
            <input class="rounded-lg border border-slate-300 px-3 py-2 font-normal" name="slug" required maxlength="190" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" placeholder="main-menu">
        </label>
        <label class="grid gap-1 text-sm font-semibold">Location
            <input class="rounded-lg border border-slate-300 px-3 py-2 font-normal" name="location" required maxlength="190" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" placeholder="primary">
        </label>
        <button class="rounded-lg bg-violet-600 px-5 py-3 font-bold text-white hover:bg-violet-700 md:col-span-3 md:justify-self-start" type="submit">Create menu</button>
    </form>
</section>

<section class="mt-8">
    <div class="flex items-end justify-between gap-4">
        <h2 class="text-xl font-bold text-slate-950">Menus</h2>
        <span class="text-sm text-slate-500">{count(menus)} total</span>
    </div>
    <div class="mt-4 grid gap-4 md:grid-cols-2">
        {for menu in menus}
            <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <h3 class="text-lg font-bold text-slate-950">{menu.title}</h3>
                <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-3 gap-y-2 text-sm">
                    <dt class="font-semibold text-slate-500">Slug</dt><dd><code>{menu.slug}</code></dd>
                    <dt class="font-semibold text-slate-500">Location</dt><dd><code>{menu.location}</code></dd>
                </dl>
            </article>
        {forelse}
            <p class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-500 md:col-span-2">No menus have been created.</p>
        {/for}
    </div>
</section>
