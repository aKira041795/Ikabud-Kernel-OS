{
    "id": "cms-akira-core",
    "name": "CMS Akira Core",
    "version": "1.0.0",
    "description": "CMS Akira product core — authoritative host module for the cms-akira suite. Declares the suite's extension points and product identity.",
    "author": "Ikabud",
    "suite": "cms-akira",
    "kind": "product-core",
    "application_profile": {
        "id": "ark.workbench",
        "version": "^0.1"
    },
    "product": {
        "id": "cms-akira",
        "name": "CMS Akira"
    },
    "extension_points": [
        "cms.sidebar",
        "cms.settings.sections",
        "cms.content.processors",
        "cms.editor.tools",
        "cms.dashboard.widgets"
    ],
    "owns_tables": [
        "cms_akira_posts"
    ],
    "reads_tables": [
        "cms_akira_posts"
    ],
    "migrations": [
        "database/migrations/001_initial.sql",
        "database/migrations/002_create_posts.sql"
    ],
    "entities": {
        "post": {
            "authority": true,
            "create_capability": "cms.post.create@1",
            "update_capability": "cms.post.update@1"
        }
    },
    "capabilities": {
        "exposes": [
            {
                "id": "cms.post.get@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "Published Post lookup owned by CMS Akira Core"
            },
            {
                "id": "cms.post.list@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "Published Post list owned by CMS Akira Core"
            },
            {
                "id": "cms.post.create@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "requires_protocol": "v2",
                "effects": {
                    "invalidates": [
                        "entity.list.post"
                    ]
                },
                "description": "Admin-only idempotent Post creation owned by CMS Akira Core"
            },
            {
                "id": "cms.post.update@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "requires_protocol": "v2",
                "effects": {
                    "invalidates": [
                        "entity.list.post"
                    ]
                },
                "description": "Admin-only idempotent Post update owned by CMS Akira Core"
            },
            {
                "id": "entity.list.post@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "Entity View list bridge projecting published Posts"
            },
            {
                "id": "entity.get.post@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "Entity View detail bridge projecting one published Post"
            }
        ],
        "depends": [
            "kernel.idempotency.hash@1",
            "kernel.idempotency.claim@1",
            "kernel.idempotency.commit@1",
            "kernel.idempotency.release@1",
            "kernel.audit.record@1"
        ]
    },
    "routes": true,
    "events": [],
    "_enabled": false
}