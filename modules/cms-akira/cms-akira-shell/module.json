                "admin",
                "administrator",
                "superadmin"
            ]
        },
        {
            "label": "Content types",
            "url": "/cms-akira-shell/content-types",
            "icon": "table-properties",
            "roles": [
                "contributor",
                "author",
                "editor",
                "admin",
                "administrator",
                "superadmin"
            ]
        },
        {
            "label": "Compositions",
            "url": "/cms-akira-shell/compositions",
            "icon": "layers",
            "roles": [
                "admin",
                "administrator",
                "superadmin"
            ]
        },
        {
            "label": "Permissions",
            "url": "/cms-akira-shell/permissions",
            "icon": "shield-check",
            "roles": [
                "admin",
                "administrator",
                "superadmin"
            ]
        },
        {
            "label": "Users",
            "url": "/cms-akira-shell/users",
