{
    "id": "cms-akira-shell",
    "name": "CMS Akira Shell",
    "version": "1.0.0",
    "description": "Kernel-authenticated tenant entry and administration shell for CMS Akira.",
    "author": "Ikabud",
    "suite": "cms-akira",
    "kind": "standalone-application",
    "entry_module": true,
    "depends": [
        "cms-akira-core",
        "cms-akira-workflow"
    ],
    "owns_tables": [],
    "reads_tables": [],
    "migrations": [],
    "capabilities": {
        "exposes": [],
        "routes": {
            "GET /cms-akira-shell/posts": "akira.post.admin.list@1",
            "GET /cms-akira-shell/posts/{slug}/edit": "akira.post.admin.get@1",
            "POST /cms-akira-shell/posts": "akira.post.create@1",
            "POST /cms-akira-shell/posts/{slug}": "akira.post.update@1",
            "POST /cms-akira-shell/posts/{slug}/taxonomies": "akira.post.set_taxonomies@1",
            "POST /cms-akira-shell/posts/{slug}/revisions/{revision_no}/revert": "akira.post.revision.revert@1",
            "POST /cms-akira-shell/posts/{slug}/workflow": "akira.workflow.transition@1",
            "POST /cms-akira-shell/categories": "akira.taxonomy.create@1",
            "POST /cms-akira-shell/categories/{id}": "akira.taxonomy.update@1",
            "POST /cms-akira-shell/categories/{id}/delete": "akira.taxonomy.delete@1",
            "POST /cms-akira-shell/content-types": "akira.content_type.create@1",
            "POST /cms-akira-shell/content-types/{id}": "akira.content_type.update@1",
            "POST /cms-akira-shell/content-types/{id}/delete": "akira.content_type.delete@1",
            "POST /cms-akira-shell/permissions": "akira.policy.set_roles@1",
            "POST /cms-akira-shell/users/{id}/role": "akira.user.update_role@1",
            "POST /cms-akira-shell/users/{id}/active": "akira.user.set_active@1"
        },
        "depends": [
            "akira.policy.list@1",
            "akira.policy.set_roles@1",
            "akira.user.list@1",
            "akira.user.update_role@1",
            "akira.user.set_active@1",
            "akira.post.admin.get@1",
            "akira.post.admin.list@1",
            "akira.post.create@1",
            "akira.post.update@1",
            "akira.post.set_taxonomies@1",
            "akira.post.revisions.list@1",
            "akira.post.revision.revert@1",
            "akira.workflow.evaluate@1",
            "akira.workflow.transition@1",
            "akira.post.delete@1",
            "akira.taxonomy.get@1",
            "akira.taxonomy.list@1",
            "akira.taxonomy.create@1",
            "akira.taxonomy.update@1",
            "akira.taxonomy.delete@1",
            "akira.content_type.get@1",
            "akira.content_type.list@1",
            "akira.content_type.create@1",
            "akira.content_type.update@1",
            "akira.content_type.delete@1",
            "entity.list.post@1",
            "entity.get.post@1",
            "akira.theme.resolve@1",
            "akira.theme.customizer.values@1",
            "akira.extension.widgets@1",
            "akira.seo.content_health@1"
        ]
    },
    "routes": true,
    "events": [],
    "nav": [
        {
            "label": "Akira Dashboard",
            "url": "/cms-akira-shell",
            "icon": "layout-dashboard",
            "roles": [
                "contributor",
                "author",
                "editor",
                "admin",
                "administrator",
                "superadmin"
            ]
        },
        {
            "label": "Posts",
            "url": "/cms-akira-shell/posts",
            "icon": "file-text",
            "roles": [
                "contributor",
                "author",
                "editor",
                "admin",
                "administrator",
                "superadmin"
            ]
        },
        {
            "label": "Categories",
            "url": "/cms-akira-shell/categories",
            "icon": "folder-tree",
            "roles": [
                "contributor",
                "author",
