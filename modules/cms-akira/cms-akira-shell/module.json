    "governance": {
        "exemptions": [
            {
                "method": "GET",
                "route": "/",
                "reason": "Public home page; anonymous readers have no actor role, so declaring this published-only surface would make dispatch fail with unknown_role."
            },
            {
                "method": "GET",
                "route": "/posts",
                "reason": "Public posts archive; anonymous readers have no actor role, so declaring this published-only surface would make dispatch fail with unknown_role."
            },
            {
                "method": "GET",
                "route": "/posts/{slug}",
                "reason": "Public published-post page; anonymous readers have no actor role, so declaring this published-only surface would make dispatch fail with unknown_role."
            },
            {
                "method": "GET",
                "route": "/sitemap.xml",
                "reason": "Public unauthenticated crawler endpoint. Dispatch authority is fail-closed and refuses anonymous callers (empty actor role), so a capability declaration here would 403 every crawler. The handler reads only the published, tenant-scoped post projection through entity.list.post@1."
            },
            {
                "method": "GET",
                "route": "/robots.txt",
                "reason": "Public unauthenticated crawler endpoint. Dispatch authority is fail-closed and refuses anonymous callers (empty actor role), so a capability declaration here would 403 every crawler. The handler reads no tenant data and names the sitemap for the requesting host."
            },
            {
                "method": "GET",
                "route": "/cms-akira-shell/forbidden",
                "reason": "Public denial page; callers sent to this static 403 surface may have no recognized Akira actor role, so declaring it would replace the intended response with dispatch's unknown_role denial."
            }
        ]
    },
    "routes": true,
