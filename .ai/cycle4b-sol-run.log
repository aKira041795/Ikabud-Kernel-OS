```sql
SELECT capability_id, capability_version, provider, caller_module,
       allowed_roles, requires_protocol, is_active
FROM capability_authorization_policies
WHERE capability_id = 'akira.builder.provenance@1'
  AND provider = 'cms-akira-builder';
