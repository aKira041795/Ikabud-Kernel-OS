# ── Ikabud Kernel OS — barebones installer .gitignore ────────────────
# Only the kernel + bundled gui-settings companion live in this repo.
# Domain modules (CMS, WMS, EHR, …) are installed at runtime and are NOT
# committed here.

# ── Runtime-installed modules ───────────────────────────────────────
# Modules added via the web GUI installer (or module:pack) land in
# modules/<id> and templates/modules/<id> at runtime. They are NOT kernel
# source and must never be pushed. Only the bundled companion is tracked.
modules/*
!modules/gui-settings/
!modules/gui-settings/**
templates/modules/*
!templates/modules/gui-settings/
!templates/modules/gui-settings/**

# CMS Akira fork — product-core (cms-akira-core) is bundled in-repo like
# gui-settings, but it is a TENANT-SELECTED module, NOT auto-installed: its
# module.json carries `_enabled: false`, so it stays inactive until a user/
# tenant activates it (CMS Modules page, `php ikabud module:enable
# cms-akira-core`, or per-tenant enableModuleForTenant). Suite members are
# enabled + tracked individually at their phase gate after host-residue cleanup;
# profile-visual remains held until the Builder gate.
!modules/cms-akira/
modules/cms-akira/*
!modules/cms-akira/cms-akira-core/
!modules/cms-akira/cms-akira-core/**
!modules/cms-akira/cms-akira-shell/
!modules/cms-akira/cms-akira-shell/**
!modules/cms-akira/cms-akira-editor/
!modules/cms-akira/cms-akira-editor/**
!modules/cms-akira/cms-akira-navigation/
!modules/cms-akira/cms-akira-navigation/**
!modules/cms-akira/cms-akira-media/
!modules/cms-akira/cms-akira-media/**
!modules/cms-akira/cms-akira-seo/
!modules/cms-akira/cms-akira-seo/**
!modules/cms-akira/cms-akira-theme/
!modules/cms-akira/cms-akira-theme/**
!modules/cms-akira/cms-akira-workflow/
!modules/cms-akira/cms-akira-workflow/**
!modules/cms-akira/cms-akira-search/
!modules/cms-akira/cms-akira-search/**
!modules/cms-akira/cms-akira-ai/
!modules/cms-akira/cms-akira-ai/**
!modules/cms-akira/cms-akira-builder/
!modules/cms-akira/cms-akira-builder/**
!modules/cms-akira/cms-akira-profile-minimal/
!modules/cms-akira/cms-akira-profile-minimal/**
!modules/cms-akira/cms-akira-profile-standard/
!modules/cms-akira/cms-akira-profile-standard/**
!modules/cms-akira/cms-akira-profile-headless/
!modules/cms-akira/cms-akira-profile-headless/**
!modules/cms-akira/README.md

# ── Local agent/tool state ──────────────────────────────────────────
/.ai/current-task.md
/.ai/debate/
/.ai/current-task.review-baseline.md
.lean-ctx/

# ── Formatter / tool caches (never commit) ──────────────────────────
.php-cs-fixer.cache

# ── Environment (never commit secrets) ─────────────────────────────
.env
*.env.local
.env.*.local

# ── Dependencies ────────────────────────────────────────────────────
vendor/
node_modules/

# ── Databases ───────────────────────────────────────────────────────
/database/*.sqlite
*.sqlite-journal

# ── Archives / backups ──────────────────────────────────────────────
*.zip
*.bak
*.bak_*
*.orig
*.rej
*.patch

# ── OS / editor ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.windsurf/
__pycache__/

# ── Debug / temp artifacts ──────────────────────────────────────────
/debug*.php
debug_cap_test.php
/dump.php
/log.txt
public/debug-opcache.php
/out*.html
/out*.txt
/test_*.php
test-results/

# ── Runtime storage (regenerate per install, never committed) ───────
storage/backups/
storage/cache/
storage/cms-installed-modules.json
storage/.installed
storage/locks/
storage/logs/
storage/module-exports/
storage/modules.json
storage/gui-settings.json
/storage/cache_www*/
/storage/report-archive/rpt_*
/storage/scheduled-reports.json
/storage/workbench/ci/
/storage/workbench/runs/
/storage/workbench/development/
/storage/academic_similarity/
/templates/_cms_active_theme

# Broader storage/private exclusion — keep specific allowlisted subdirs
/storage/private/**
!/storage/private/.gitkeep
/storage/private/comprehension/history/
/storage/private/comprehension/cases/
/storage/private/pal/

# ── Runtime module markers / generated uploads ──────────────────────
modules/**/.cms-owned
/public/uploads/**
!/public/uploads/.gitkeep

# ── Test runner output (regenerated by scripts/run-tests.php) ───────
test_results/
!test_results/
test_results/*
!test_results/browser/fingerprint-baseline.json

# ── Release metadata ────────────────────────────────────────────────
release-manifest.json

# ── Manual HTTP load-testing tool (excluded from default suite) ─────
/tests/load_test.php
