#!/usr/bin/env bash

set -euo pipefail

TASK="${*:-}"

if [[ -z "$TASK" ]]; then
    echo "Usage: tools/ai-task \"task description\""
    exit 1
fi

mkdir -p .ai

cat > .ai/current-task.md <<EOF
# Current Task

## Request

$TASK

## Status

Awaiting architecture plan.
EOF

echo "Created .ai/current-task.md"
echo
echo "Next commands:"
echo "  Codex:    /architect $TASK"
echo "  Harness:  bash tools/pi-arch-review.sh                       # DS Pro + Codex Sol independent review"
echo "  Harness:  python3 tools/pi-arch-debate.py \"$TASK\"          # DS Pro drafts + Codex Sol critiques -> current-task.md"
echo "  DeepSeek: /implement"
echo "  DeepSeek: /review"
echo "  Codex:    /release-gate"
echo "  Autonomy: php tools/ai-autonomy.php plan --emit-manifest=/tmp/wf.json"
echo "  Workflow: harpp workflow start --manifest=/tmp/wf.json --conversation=<id> --authority-level=L2"
echo "  Defer:    php tools/ai-autonomy.php defer --task=TASK_ID --question='...' --why='...' --option='a|Label|Effect|Cost|Blast radius|reversible' --option='b|Label|Effect|Cost|Blast radius|reversible' --recommend=a"
