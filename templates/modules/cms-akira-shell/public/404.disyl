{extends "modules/cms-akira-shell/public/layout.disyl"}
{block content}<section{if archive_disabled} data-akira-public-archive="disabled"{/if} class="mx-auto max-w-3xl px-5 py-28 text-center"><p class="text-sm font-bold uppercase tracking-widest text-violet-600">404</p><h1 class="mt-4 text-5xl font-black text-slate-950">{not_found_heading}</h1><p class="mt-5 text-slate-500">{not_found_message}</p><a class="mt-8 inline-block rounded-2xl bg-violet-600 px-6 py-3 font-bold text-white" href="{not_found_link}">{not_found_link_label}</a></section>{/block}
