<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{page_title}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://unpkg.com/alpinejs@3.14.3/dist/cdn.min.js"></script>
    <script>
        tailwind.config = { theme: { extend: { colors: { akira: {
            50:'#f5f3ff',100:'#ede9fe',200:'#ddd6fe',300:'#c4b5fd',400:'#a78bfa',
            500:'#8b5cf6',600:'#7c3aed',700:'#6d28d9',800:'#5b21b6',900:'#4c1d95',950:'#2e1065'
        } } } } };
    </script>
</head>
<body class="flex min-h-screen items-center justify-center bg-gradient-to-br from-slate-950 via-slate-900 to-akira-950 px-4">
    <main class="w-full max-w-md" x-data="akiraLogin()">
        <div class="overflow-hidden rounded-2xl border border-white/10 bg-white/95 shadow-2xl backdrop-blur">
            <div class="px-8 pb-7 pt-8">
                <div class="flex items-center justify-center gap-3">
                    <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-akira-600 text-xl font-extrabold text-white shadow-lg shadow-akira-600/20">A</div>
                    <div><h1 class="text-xl font-extrabold tracking-tight text-slate-900">CMS Akira</h1><p class="text-xs text-slate-500">Sign in to manage content</p></div>
                </div>
                <div x-show="error" x-cloak x-text="error" role="alert" class="mt-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>
                <form @submit.prevent="submit()" class="mt-6 space-y-4">
                    <div><label for="username" class="mb-1 block text-xs font-semibold text-slate-600">{login_username_label}</label><input id="username" type="text" x-model="form.username" autocomplete="username" autofocus required class="w-full rounded-lg border border-slate-200 bg-white px-4 py-3 focus:border-akira-500 focus:outline-none focus:ring-2 focus:ring-akira-500/20"></div>
                    <div><label for="password" class="mb-1 block text-xs font-semibold text-slate-600">Password</label><input id="password" type="password" x-model="form.password" autocomplete="current-password" required class="w-full rounded-lg border border-slate-200 bg-white px-4 py-3 focus:border-akira-500 focus:outline-none focus:ring-2 focus:ring-akira-500/20"></div>
                    <div class="flex justify-end"><a href="{login_forgot_url}" class="text-xs font-medium text-akira-700 hover:text-akira-900">Forgot password?</a></div>
                    <button type="submit" :disabled="loading" class="w-full rounded-lg bg-akira-600 py-3 font-semibold text-white transition-colors hover:bg-akira-700 disabled:opacity-60"><span x-text="loading ? '{login_loading_text}' : '{login_button_text}'"></span></button>
                </form>
            </div>
            <div class="border-t border-slate-100 bg-slate-50 px-8 py-4 text-center text-[11px] text-slate-500">Powered by Ikabud Kernel OS</div>
        </div>
    </main>
    <script>
        function akiraLogin(){return{loading:false,error:'',form:{username:'',password:''},async submit(){this.error='';this.loading=true;try{const response=await fetch('{login_endpoint}',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(this.form)});const result=await response.json();if(result.ok&&result.redirect){window.location.href=result.redirect;return}this.error=result.error||'Login failed'}catch(e){this.error='Network error'}this.loading=false}}}
    </script>
</body>
</html>
