{include "pages/partials/error-page.disyl" with {
    status_code: status_code|default:503,
    page_title:  page_title|default:'',
    error_title: error_title|default:"We'll be back soon",
    message:     message|default:'This site is temporarily offline while scheduled maintenance is in progress. Please check back shortly.'
}}
{* 503 — Scheduled maintenance.
   Renders the shared kernel error card (dark gradient + frosted card like
   every other error surface). Callers pass back_url/action_label for the
   primary recovery action (default: none → no button). *}
