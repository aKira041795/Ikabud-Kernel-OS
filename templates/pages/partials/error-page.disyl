<!DOCTYPE html>
{* =============================================================================
   Shared kernel error page — single source of truth for every error/status
   surface (pages/404, pages/500, pages/entry-module-unavailable and
   pages/maintenance all render through this partial).

   Design language mirrors the reference CMS login/shell surfaces and the
   kernel admin shell (templates/layouts/kernel-admin.disyl):
     • Tailwind CSS via the CDN, declared in <head>
     • kernel module palette via tailwind.config (same indigo scale as the
       kernel admin shell)
     • inline SVG glyphs (CSP-safe), no eval, Alpine optional

   Context contract — every key is safe-defaulted, no key is required:
     status_code   int    HTTP status (default 500)
     page_title    string Document title (default: derived from status)
     error_title   string Headline (default: derived from status)
     message       string Body copy (default: derived from status)
     detail        string Optional extra context — only rendered when
                            show_detail is truthy. Never pass exception text
                            or stack traces (500 surfaces never set it).
     show_detail   bool   Safe flag gating the detail block (default false)
     back_url      string Optional; a primary action button is rendered only
                            when a non-empty back_url is provided
     action_label  string Button label (default "Go back")
     icon          string Built-in glyph name: search | lock | globe | server |
                            tool | wrench | clock | shield (default: derived
                            from status) — the seam for future inline icons
     image         string Optional absolute URL; when present it wins over
                            icon and renders an <img> (future image provision)

   No PHP context is required: an empty context renders a graceful generic
   "HTTP 500 — Something went wrong" card without warnings.
   ========================================================================== *}

{* Normalize status + copy once so <title>, the headline, the status pill and
   the glyph choice all agree. Caller-supplied values always win. *}
{set __status = status_code|default:500}

{set __title = error_title|default:''}
{if __title == ''}
    {if __status == 404}{set __title = 'Page not found'}
    {elseif __status == 403}{set __title = 'Access denied'}
    {elseif __status == 401}{set __title = 'Sign-in required'}
    {elseif __status == 503}{set __title = 'Service unavailable'}
    {else}{set __title = 'Something went wrong'}
    {/if}
{/if}

{set __message = message|default:''}
{if __message == ''}
    {if __status == 404}{set __message = 'The page you requested could not be found. It may have moved, the link may be out of date, or the address may be incorrect.'}
    {elseif __status == 403}{set __message = 'You do not have permission to view this page. If you believe this is a mistake, please contact your administrator.'}
    {elseif __status == 401}{set __message = 'Your session has expired or you are not signed in. Please sign in again to continue.'}
    {elseif __status == 503}{set __message = 'This service is temporarily unavailable. Please try again shortly.'}
    {else}{set __message = 'An unexpected error occurred. The issue has been logged for review.'}
    {/if}
{/if}

{set __phrase = ''}
{if __status == 404}{set __phrase = 'Not Found'}
{elseif __status == 403}{set __phrase = 'Forbidden'}
{elseif __status == 401}{set __phrase = 'Unauthorized'}
{elseif __status == 503}{set __phrase = 'Service Unavailable'}
{/if}

{set __icon = icon|default:''}
{if __icon == ''}
    {if __status == 404}{set __icon = 'search'}
    {elseif __status == 403}{set __icon = 'lock'}
    {elseif __status == 401}{set __icon = 'globe'}
    {elseif __status == 503}{set __icon = 'tool'}
    {else}{set __icon = 'server'}
    {/if}
{/if}

{set __page_title = page_title|default:''}
{if __page_title == ''}{set __page_title = __title}{/if}

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{__page_title} — {app_name|default:'Ikabud'}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        kernel: {
                            50: '#f0f4ff', 100: '#dbe4ff', 200: '#bac8ff', 300: '#91a7ff',
                            400: '#748ffc', 500: '#5c7cfa', 600: '#4c6ef5', 700: '#4263eb',
                            800: '#3b5bdb', 900: '#364fc7', 950: '#2b3fa0',
                        },
                    },
                },
            },
        };
    </script>
</head>
<body class="min-h-screen bg-gradient-to-br from-slate-950 via-slate-900 to-sky-950 flex items-center justify-center px-4 py-10 font-sans antialiased">

    <div class="w-full max-w-md">
        <main class="bg-white/95 backdrop-blur rounded-2xl shadow-2xl border border-white/10 overflow-hidden" role="main" aria-labelledby="error-title">

            <div class="px-8 pt-10 pb-8 text-center">

                {* Status glyph / image — image wins when provided, otherwise a
                   built-in icon by name, otherwise a default glyph. *}
                <div class="mx-auto mb-6 w-20 h-20 rounded-2xl bg-kernel-600/10 border border-kernel-500/20 flex items-center justify-center text-kernel-600 overflow-hidden" aria-hidden="true">
                    {if image|default:'' != ''}
                        <img src="{image}" alt="" class="w-full h-full object-contain p-2.5">
                    {elseif __icon == 'search'}
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
                    {elseif __icon == 'lock'}
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                    {elseif __icon == 'globe'}
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
                    {elseif __icon == 'server'}
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="7" rx="2"/><rect x="3" y="14" width="18" height="7" rx="2"/><path d="M7 6.5h.01M7 17.5h.01"/></svg>
                    {elseif __icon == 'tool' || __icon == 'wrench'}
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                    {elseif __icon == 'clock'}
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    {elseif __icon == 'shield'}
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    {else}
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
                    {/if}
                </div>

                {* Status pill — clear status code, uniform on every surface *}
                <div class="inline-flex items-center gap-2 rounded-full bg-kernel-600/10 border border-kernel-500/20 px-3 py-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-kernel-500"></span>
                    <span class="font-mono text-[11px] font-bold uppercase tracking-[0.14em] text-kernel-700">HTTP {__status}</span>
                    {if __phrase != ''}
                        <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-400">· {__phrase}</span>
                    {/if}
                </div>

                <h1 id="error-title" class="mt-5 text-3xl font-extrabold tracking-tight text-slate-900">{__title}</h1>

                <p class="mt-3 text-[15px] leading-relaxed text-slate-600 max-w-sm mx-auto">{__message}</p>

                {* Optional safe detail — gated by show_detail; never used by
                   500 surfaces and never fed exception/stack content. *}
                {if show_detail|default:false && detail|default:'' != ''}
                    <div class="mt-4 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-left">
                        <div class="text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-1">Details</div>
                        <div class="text-[13px] leading-relaxed text-slate-600 break-words">{detail}</div>
                    </div>
                {/if}

                {* Optional primary action — rendered only when back_url is set *}
                {if back_url|default:'' != ''}
                    <div class="mt-8">
                        <a href="{back_url}" class="inline-flex items-center justify-center w-full py-3 px-6 rounded-xl bg-kernel-600 text-white text-sm font-semibold hover:bg-kernel-700 transition-colors shadow-lg shadow-kernel-600/20">
                            {action_label|default:'Go back'}
                        </a>
                    </div>
                {/if}
            </div>

            {* Small uniform footer *}
            <div class="px-8 py-4 bg-slate-50 border-t border-slate-100 text-[11px] text-slate-500 flex items-center justify-between">
                <span>{app_name|default:'Ikabud'} Kernel</span>
                <span class="font-mono">HTTP {__status}</span>
            </div>
        </main>
    </div>

</body>
</html>
