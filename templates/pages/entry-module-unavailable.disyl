{include "pages/partials/error-page.disyl" with {
    status_code: status_code|default:503,
    page_title:  page_title|default:'',
    error_title: error_title|default:'Entry module unavailable',
    message:     message|default:'The entry module for this tenant could not be loaded safely. Please check module health and recent runtime logs.'
}}
{* 503 — Tenant entry module unavailable.
   Renders the shared kernel error card with recovery copy. Callers may pass
   a safe detail (e.g. the entry module id) with show_detail:true. *}
